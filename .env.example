# ─────────────────────────────────────────────────────────────────────────────
# VELTRIX — environment variables
# Copy to .env.local (never commit it). Only NEXT_PUBLIC_* reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# production | preview | development
NODE_ENV=development

# 32+ random chars. Signs sessions and private storage links.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Absolute public URL of the app (used in emails and signed links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# If DATABASE_URL is present, the PostgreSQL driver is used.
# If it is absent, the app falls back to SQLite (development only).
# Supabase: Project Settings → Database → Connection string (pooler, port 6543).
DATABASE_URL=
# SQLite fallback location (ignored when DATABASE_URL is set)
SQLITE_PATH=.data/veltrix.db
# "disable" only for local Postgres without TLS
PG_SSL=require

# --- Supabase ---------------------------------------------------------------
# Used for Auth, Storage and RLS-scoped client access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose: bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for POD photos/signatures and documents (must be private).
SUPABASE_STORAGE_BUCKET=veltrix-documents

# --- Background jobs --------------------------------------------------------
# Shared secret for /api/v1/jobs/notifications and outbound webhooks (HMAC SHA-256).
# Without it those endpoints answer 503 instead of pretending to work.
JOBS_SECRET=
# Cron expression is configured in vercel.json; the secret is passed in the header.

# --- Integrations (all optional) -------------------------------------------
# Email (Resend). Without RESEND_API_KEY, notifications stay queued and are
# marked failed with an explicit reason — no email is simulated.
RESEND_API_KEY=
EMAIL_FROM="VELTRIX <no-reply@example.com>"

# Routing. Without a provider the app labels distances as estimates.
ROUTING_PROVIDER=                 # osrm | openrouteservice | graphhopper
ROUTING_API_KEY=
ROUTING_BASE_URL=

# Geocoding (MapTiler or Mapbox). Without a key, address coordinates must be
# entered manually and the UI says so.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
GEOCODING_API_KEY=

# Payments (Stripe). Without keys, invoices can only be settled as manual
# bank-transfer test entries, and the UI states that no card payment occurred.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Messaging (SMS/WhatsApp) — optional, adapter exists, provider not configured.
SMS_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Demo data --------------------------------------------------------------
# "true" seeds demo records clearly flagged as non-operational.
SEED_DEMO_DATA=true
# Demo account password. Never reuse this value outside demo environments.
DEMO_PASSWORD=

# --- Observability ----------------------------------------------------------
# Optional Sentry/OTel endpoint. Without it, structured logs go to stdout.
SENTRY_DSN=
LOG_LEVEL=info
